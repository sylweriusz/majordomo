<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Entitlements for the bundled whisper-cli / whisper-dictate helpers under
    hardened runtime. The app passes DYLD_LIBRARY_PATH / GGML_BACKEND_PATH to
    the helper process so it can find its embedded Metal/ggml dylibs; hardened
    runtime strips DYLD_* env vars unless the first entitlement is present.
    Library validation is relaxed so the helper can load those app-owned
    dylibs.

    NOTE: verify against notarization output before relying on these.
  -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
